# =============================================================================
# Git Ignore Configuration for Vine (Rust gRPC library)
# =============================================================================

# Prevent accidental commits of editor/refactor backup files
*.backup

# Rust build output
/Target/

# Generated protobuf (regenerated by build.rs)
/Source/Generated/

# Documentation
Documentation/Rust/debug
Documentation/Rust/release
Documentation/Rust/.rustc_info.json
Documentation/Rust/.rustdoc_fingerprint.json
Documentation/Rust/CACHEDIR.TAG
